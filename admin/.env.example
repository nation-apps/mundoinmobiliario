# Panel de administración de Mundo Inmobiliario (Next.js). Railway → servicio «admin», Root Directory /admin.
# Los valores reales van solo en las variables de Railway o en .env.local (nunca en el repositorio).

# Supabase → Project Settings → API. Son públicas por diseño (la seguridad la da RLS), pero se
# necesitan en el build: cárgalas en Railway antes del primer despliegue.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública del bot en Railway (https://<dominio>.up.railway.app), sin barra final.
# El servidor del panel la usa para reenviar las acciones del staff al bot.
BOT_API_URL=
# La misma URL; solo se muestra en la pantalla de Canales para copiar el webhook.
NEXT_PUBLIC_BOT_API_URL=
