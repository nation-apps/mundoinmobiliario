# ---- Bot de Mundo Inmobiliario (carpeta bot/) — copiar a Railway como variables ----
# Núcleo (obligatorias)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
PUBLIC_BASE_URL=https://TU-BOT.up.railway.app
# Número (52 + 10 dígitos) que recibe el aviso de «conversación escalada» y el de tope de gasto
ESCALATION_PHONE=
ANTHROPIC_API_KEY=
DAILY_TOKEN_BUDGET=500000
BUSINESS_TIMEZONE=America/Mexico_City

# WhatsApp Cloud API (app «Mundo Motos»). Mientras no haya número propio, usa el número de PRUEBA de Meta
# (gratis, hasta 5 destinatarios verificados y 250 mensajes cada 24 h).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Solo con número propio: PIN de 6 dígitos de verificación en dos pasos (el bot registra el número al arrancar)
WHATSAPP_REGISTER_PIN=
WHATSAPP_TEMPLATE_LANG=es_MX

# Messenger / Instagram / comentarios (opcional: sin esto el canal queda apagado)
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_ACCOUNT_ID=
META_HUMAN_AGENT_APROBADO=false

# Panel (cuando exista) y formularios del sitio
ADMIN_ORIGINS=
WEB_ORIGINS=
PUBLIC_LEADS_TOKEN=

# Comportamiento (opcionales)
RITMO_HUMANO=true
RITMO_FACTOR=1
REENVIOS_ACTIVOS=true
LOG_LEVEL=info
